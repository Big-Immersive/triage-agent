# ---- engine (CLI) ----
OPENROUTER_API_KEY=sk-or-v1-...
# TRIAGE_PROVIDER=ollama      # fully local instead
# TRIAGE_LLM=z-ai/glm-5.3     # override the model

# ---- dashboard backend (server/) ----
DATABASE_URL=postgresql+asyncpg://triage:triage@localhost:5432/triage   # Railway injects postgres://...; both work
TRIAGE_SECRET_KEY=change-me-to-a-long-random-string           # JWT signing + encryption of stored LLM keys
TRIAGE_DATA_DIR=./data                                         # local blob storage root (STORAGE_BACKEND=local)
CORS_ORIGINS=http://localhost:5173                             # comma-separated; add the UI's Railway domain in prod
COOKIE_SECURE=false                                            # true behind HTTPS
# STORAGE_BACKEND=s3            # multi-replica deploys: any S3-compatible bucket
# S3_BUCKET=triage-files
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# RUN_WORKERS=4                 # concurrent runs per replica
# DB_POOL_SIZE=10
